rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Perfil mínimo criado pelo cliente durante o cadastro. Cada usuário só
    // pode acessar o próprio documento.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // O estado econômico e as recompensas são acessados somente pelas funções
    // server-side com Admin SDK, que não é limitado por estas regras.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
