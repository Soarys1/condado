rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /condado_profiles/{uid} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }

    match /condado_nick_index/{nick} {
      allow read, write: if false;
    }

    match /condado_player_index/{playerId} {
      allow read, write: if false;
    }

    match /condado_email_index/{email} {
      allow read, write: if false;
    }

    match /condado_devices/{id} {
      allow read, write: if false;
    }

    match /condado_transfers/{id} {
      allow read, write: if false;
    }

    match /condado_market/{id} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /condado_week_claims/{id} {
      allow read, write: if false;
    }

    match /condado_chat/{id} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /condado_raid_inbox/{id} {
      allow read, write: if false;
    }

    match /condado_raid_sessions/{id} {
      allow read, write: if false;
    }

    match /condado_economy_ledger/{id} {
      allow read, write: if false;
    }

    match /condado_audit_logs/{id} {
      allow read, write: if false;
    }

    match /condado_request_ids/{id} {
      allow read, write: if false;
    }

    match /condado_rate_limits/{id} {
      allow read, write: if false;
    }

    match /condado_alliances/{id} {
      allow read, write: if false;
    }

    match /condado_alliance_names/{id} {
      allow read, write: if false;
    }

    match /condado_war_queue/{id} {
      allow read, write: if false;
    }

    match /condado_live/{id} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /usuarios/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
